<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@200;300;400;500;600;700&display=swap" rel="stylesheet">

<style>
  :root{
    --paper:    #FCFCFB;
    --panel:    #F1F1EF;
    --panel-2:  #E9E9E6;
    --ink:      #16161A;
    --ink-mid:  #56565C;
    --ink-soft: #9A9A9E;
    --line:     #E7E7E4;
    --accent:   #1B33E0;   /* single electric accent — set to #15151A for pure B&W */

    --sans:"Manrope", system-ui, -apple-system, sans-serif;

    --t-hero:  clamp(2.3rem, 6vw, 5rem);
    --t-title: clamp(1.8rem, 4.2vw, 3rem);
    --t-h3:    clamp(1.15rem, 2vw, 1.5rem);
    --t-lead:  clamp(1.08rem, 1.5vw, 1.34rem);
    --t-body:  clamp(1.02rem, 1.15vw, 1.12rem);
    --t-label: 0.66rem;

    --maxw: 1320px;
    --measure: 58ch;
    --gap: clamp(1.6rem, 3.2vw, 3rem);
    --section-y: clamp(5rem, 11vw, 10rem);
    --ease: cubic-bezier(.22,.61,.36,1);
  }

  *{ box-sizing:border-box; margin:0; padding:0; }
  html{ scroll-behavior:smooth; -webkit-text-size-adjust:100%; }
  body{
    background:var(--paper); color:var(--ink);
    font-family:var(--sans); font-size:var(--t-body); font-weight:400; line-height:1.72;
    -webkit-font-smoothing:antialiased; text-rendering:optimizeLegibility; overflow-x:hidden;
  }
  ::selection{ background:var(--ink); color:var(--paper); }
  a{ color:inherit; text-decoration:none; }
  img{ max-width:100%; display:block; }

  .wrap{ width:100%; max-width:var(--maxw); margin-inline:auto; padding-inline:clamp(1.25rem,5vw,4.5rem); }
  section{ padding-block:var(--section-y); }

  .label{ font-size:var(--t-label); letter-spacing:.2em; text-transform:uppercase; color:var(--ink-soft); font-weight:600; }
  .lead{ font-size:var(--t-lead); line-height:1.5; max-width:var(--measure); color:var(--ink-mid); font-weight:300; }
  h1,h2,h3{ font-weight:200; line-height:1.05; letter-spacing:-0.01em; }
  h3{ font-weight:300; font-size:var(--t-h3); line-height:1.2; letter-spacing:0; }

  a:focus-visible, button:focus-visible{ outline:2px solid var(--accent); outline-offset:4px; }

  /* reveal */
  .reveal{ opacity:0; transform:translateY(14px); transition:opacity .8s var(--ease), transform .8s var(--ease); }
  .reveal.in{ opacity:1; transform:none; }
  .reveal.d1{ transition-delay:.07s; } .reveal.d2{ transition-delay:.14s; } .reveal.d3{ transition-delay:.21s; }

  /* ── top nav ───────────────────────────────────────── */
  .nav{ position:fixed; inset:0 0 auto 0; z-index:50; display:flex; justify-content:space-between; align-items:center;
    padding:clamp(.95rem,2vw,1.5rem) clamp(1.25rem,5vw,4.5rem);
    background:color-mix(in srgb, var(--paper) 78%, transparent); backdrop-filter:blur(14px);
    border-bottom:1px solid transparent; transition:border-color .4s ease; }
  .nav.scrolled{ border-bottom-color:var(--line); }
  .nav .wm{ font-weight:600; font-size:.8rem; letter-spacing:.06em; }
  .nav .links{ display:flex; gap:clamp(1.1rem,2.4vw,2.4rem); }
  .nav .links a{ font-size:var(--t-label); letter-spacing:.18em; text-transform:uppercase; color:var(--ink-mid); font-weight:600; }
  .nav .links a:hover{ color:var(--ink); }

  /* ── right index rail ─────────────────────────────── */
  .rail{ position:fixed; right:clamp(1rem,2.2vw,1.9rem); top:50%; transform:translateY(-50%); z-index:40; display:flex; flex-direction:column; align-items:flex-end; gap:.65rem; }
  .rail a{ font-size:.64rem; letter-spacing:.06em; color:var(--ink-soft); font-variant-numeric:tabular-nums; font-weight:500; transition:color .3s; }
  .rail a:hover{ color:var(--ink); }
  .rail a.active{ color:var(--accent); }

  /* ── meta row (top of sections) ───────────────────── */
  .meta-line{ display:flex; justify-content:space-between; gap:1rem; flex-wrap:wrap; padding-bottom:clamp(1.4rem,3vw,2rem); }

  /* ── hero ──────────────────────────────────────────── */
  .hero{ min-height:94svh; display:flex; flex-direction:column; justify-content:center; padding-top:clamp(6rem,13vh,9rem); padding-bottom:clamp(3rem,7vh,5rem); }
  .hero .meta-line{ border:none; padding-bottom:clamp(1.8rem,4vw,2.8rem); }
  .hero h1{ font-size:var(--t-hero); max-width:18ch; margin-bottom:clamp(1.4rem,3vw,2.2rem); }
  .hero h1 em{ font-style:normal; }
  .hero .lead{ max-width:54ch; }
  .hero-line{ display:block; overflow:hidden; }
  .hero-line > span{ display:block; transform:translateY(110%); animation:rise 1s var(--ease) forwards; }
  .hero-line:nth-child(1) > span{ animation-delay:.12s; }
  .hero-line:nth-child(2) > span{ animation-delay:.24s; }
  .hero-line:nth-child(3) > span{ animation-delay:.36s; }
  @keyframes rise{ to{ transform:translateY(0); } }

  /* ── image panels (clean, frameless) ──────────────── */
  .panel{ background:var(--panel); position:relative; display:flex; align-items:center; justify-content:center; flex-direction:column; gap:.45rem; text-align:center; padding:2rem; aspect-ratio:16/10; width:100%; overflow:hidden; }
  .panel.tall{ aspect-ratio:9/16; }
  .panel.wide{ aspect-ratio:16/6.5; }
  .panel .pl{ font-size:var(--t-label); letter-spacing:.18em; text-transform:uppercase; color:var(--ink-mid); font-weight:600; }
  .panel .ph{ font-size:.76rem; color:var(--ink-soft); font-weight:300; }
  /* faint corner ticks — technical feel */
  .panel::before, .panel::after{ content:""; position:absolute; width:14px; height:14px; opacity:.5; }
  .panel::before{ top:12px; left:12px; border-top:1px solid var(--ink-soft); border-left:1px solid var(--ink-soft); }
  .panel::after{ bottom:12px; right:12px; border-bottom:1px solid var(--ink-soft); border-right:1px solid var(--ink-soft); }
  .cap{ font-size:.72rem; letter-spacing:.04em; color:var(--ink-soft); margin-top:.8rem; font-weight:500; }

  /* media fills a panel cleanly — no padding, no corner ticks */
  .panel.media{ padding:0; }
  .panel.media::before, .panel.media::after{ display:none; }
  .panel.media > img, .panel.media > video{ position:absolute; inset:0; width:100%; height:100%; object-fit:cover; }

  /* live, clickable Figma prototype embed */
  .embed{ position:relative; width:100%; aspect-ratio:16/10; border:1px solid var(--line); background:var(--panel); }
  .embed.tall{ aspect-ratio:9/16; max-width:380px; margin-inline:auto; }
  .embed > iframe{ position:absolute; inset:0; width:100%; height:100%; border:0; }

  /* ── project ───────────────────────────────────────── */
  .proj{ padding-top:clamp(3rem,6vw,6rem); }
  .proj-head{ display:grid; grid-template-columns:1fr; gap:clamp(1rem,2.4vw,1.6rem); align-items:start; margin-bottom:clamp(2.4rem,5vw,4rem); }
  .proj-tags{ display:flex; flex-wrap:wrap; gap:.4rem; }
  .tag{ font-size:var(--t-label); letter-spacing:.14em; text-transform:uppercase; color:var(--ink-mid); border:1px solid var(--line); border-radius:100px; padding:.35rem .8rem; font-weight:500; }
  .proj-title{ font-size:var(--t-title); max-width:16ch; }
  .proj-lead{ color:var(--ink-mid); font-weight:300; max-width:50ch; font-size:var(--t-lead); line-height:1.5; }

  /* dotted-leader spec list (the signature) */
  .specs{ display:grid; gap:.55rem; max-width:480px; margin-top:.4rem; }
  .spec{ display:grid; grid-template-columns:auto 1fr auto; align-items:end; gap:.7rem; }
  .spec .k{ font-size:var(--t-label); letter-spacing:.14em; text-transform:uppercase; color:var(--ink-soft); font-weight:600; padding-bottom:.12rem; }
  .spec .fill{ border-bottom:1px dotted var(--ink-soft); height:.7em; opacity:.5; }
  .spec .v{ font-size:.86rem; color:var(--ink); font-weight:500; font-variant-numeric:tabular-nums; padding-bottom:.02rem; }

  .viewlink{ display:inline-flex; align-items:center; gap:.5rem; margin-top:1.6rem; font-size:var(--t-label); letter-spacing:.16em; text-transform:uppercase; color:var(--accent); font-weight:600; }
  .viewlink .arr{ transition:transform .3s var(--ease); }
  .viewlink:hover .arr{ transform:translateY(2px); }

  .proj-visual{ display:grid; gap:var(--gap); }
  .grid-2{ display:grid; grid-template-columns:1fr; gap:var(--gap); }
  .phones{ display:grid; grid-template-columns:repeat(2,1fr); gap:var(--gap); }
  .ba{ display:grid; grid-template-columns:1fr; gap:var(--gap); }
  .ba .balabel{ font-size:var(--t-label); letter-spacing:.16em; text-transform:uppercase; color:var(--ink-soft); font-weight:600; margin-bottom:.7rem; }

  /* ── detail ────────────────────────────────────────── */
  .detail{ margin-top:clamp(3rem,6vw,5rem); }
  .pa{ display:grid; grid-template-columns:1fr; gap:var(--gap); border-top:1px solid var(--line); padding-top:clamp(2rem,4vw,3rem); margin-block:clamp(2.4rem,5vw,3.6rem); }
  .pa .k{ font-size:var(--t-label); letter-spacing:.16em; text-transform:uppercase; color:var(--ink-soft); font-weight:600; margin-bottom:.9rem; }
  .pa p{ color:var(--ink); font-weight:300; max-width:50ch; }

  .block{ margin-block:clamp(2.6rem,5vw,4rem); }
  .block .label{ display:block; margin-bottom:.9rem; }
  .block h3{ margin-bottom:1.1rem; max-width:24ch; }
  .block p{ color:var(--ink-mid); font-weight:300; max-width:var(--measure); }
  .block p + p{ margin-top:1rem; }
  .block .panel{ margin-top:1.6rem; }

  .note{ border-left:1px solid var(--accent); padding:.1rem 0 .1rem 1.1rem; margin-block:clamp(1.4rem,3vw,2rem); color:var(--ink-mid); font-size:.9rem; font-weight:300; max-width:62ch; }
  .note b{ color:var(--ink); font-weight:600; }

  .reflection{ font-size:var(--t-title); font-weight:200; line-height:1.2; max-width:22ch; color:var(--ink); margin-top:clamp(2.5rem,5vw,4rem); padding-top:clamp(1.6rem,3vw,2.4rem); border-top:1px solid var(--line); }

  .pull{ padding-block:clamp(4rem,8vw,7rem); }
  .pull p{ font-size:var(--t-title); font-weight:200; line-height:1.2; max-width:20ch; }
  .pull .by{ font-size:var(--t-label); letter-spacing:.16em; text-transform:uppercase; color:var(--ink-soft); font-weight:600; margin-top:1.4rem; }

  /* ── other work ────────────────────────────────────── */
  .other-grid{ display:grid; grid-template-columns:1fr; gap:var(--gap); margin-top:clamp(1.8rem,3.5vw,2.8rem); }

  /* ── about ─────────────────────────────────────────── */
  .about-grid{ display:grid; grid-template-columns:1fr; gap:clamp(2.4rem,5vw,4.5rem); align-items:start; }
  .about h2{ font-size:var(--t-title); max-width:14ch; margin-block:1.1rem 1.8rem; }
  .about p{ max-width:var(--measure); color:var(--ink-mid); font-weight:300; }
  .about p + p{ margin-top:1.1rem; }
  .facts{ margin-top:2.2rem; display:grid; gap:.55rem; max-width:520px; }

  /* ── contact ───────────────────────────────────────── */
  .contact h2{ font-size:var(--t-hero); max-width:13ch; margin-block:1.2rem clamp(2rem,4vw,3rem); }
  .clinks{ display:grid; gap:.7rem; max-width:560px; }
  .crow{ display:grid; grid-template-columns:auto 1fr auto; align-items:end; gap:.9rem; padding-block:.7rem; border-bottom:1px solid var(--line); transition:border-color .3s; }
  .crow .k{ font-size:var(--t-label); letter-spacing:.16em; text-transform:uppercase; color:var(--ink-soft); font-weight:600; padding-bottom:.2rem; }
  .crow .fill{ border-bottom:1px dotted var(--ink-soft); height:.7em; opacity:.4; }
  .crow .v{ font-size:var(--t-h3); font-weight:300; }
  .crow:hover{ border-bottom-color:var(--accent); }
  .crow:hover .v{ color:var(--accent); }

  footer{ border-top:1px solid var(--line); }
  footer .wrap{ padding-block:2.4rem; display:flex; justify-content:space-between; flex-wrap:wrap; gap:1rem; font-size:var(--t-label); letter-spacing:.14em; text-transform:uppercase; color:var(--ink-soft); font-weight:600; }

  /* ── responsive ────────────────────────────────────── */
  @media (min-width:760px){
    .grid-2{ grid-template-columns:1fr 1fr; }
    .ba{ grid-template-columns:1fr 1fr; }
    .phones{ grid-template-columns:repeat(4,1fr); }
    .other-grid{ grid-template-columns:repeat(3,1fr); }
    .about-grid{ grid-template-columns:1.5fr 1fr; }
    .pa{ grid-template-columns:1fr 1fr; }
  }
  @media (min-width:920px){
    .proj-head{ grid-template-columns:1.1fr .9fr; column-gap:clamp(2rem,5vw,5rem); }
    .proj-head .specs-wrap{ grid-column:2; grid-row:1 / span 4; align-self:start; }
  }
  @media (max-width:980px){ .rail{ display:none; } }

  @media (prefers-reduced-motion:reduce){
    *{ animation:none !important; transition:none !important; scroll-behavior:auto !important; }
    .reveal{ opacity:1; transform:none; }
    .hero-line > span{ transform:none; }
  }
</style>
</head>

