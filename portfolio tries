<script>
  document.getElementById('year').textContent = new Date().getFullYear();

  const nav = document.getElementById('nav');
  const onScroll = () => nav.classList.toggle('scrolled', scrollY > 24);
  onScroll(); addEventListener('scroll', onScroll, { passive:true });

  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduce && 'IntersectionObserver' in window){
    const io = new IntersectionObserver((es)=>{ es.forEach(e=>{ if(e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target); } }); }, { threshold:.12, rootMargin:'0px 0px -8% 0px' });
    document.querySelectorAll('.reveal').forEach(el=>io.observe(el));
  } else { document.querySelectorAll('.reveal').forEach(el=>el.classList.add('in')); }

  const railLinks = [...document.querySelectorAll('.rail a')];
  const byId = Object.fromEntries(railLinks.map(a=>[a.dataset.rail, a]));
  const railIO = new IntersectionObserver((es)=>{
    es.forEach(e=>{ if(e.isIntersecting){ railLinks.forEach(a=>a.classList.remove('active')); const el=byId[e.target.getAttribute('data-rail-section')]; if(el) el.classList.add('active'); } });
  }, { threshold:.4, rootMargin:'-20% 0px -40% 0px' });
  document.querySelectorAll('[data-rail-section]').forEach(s=>railIO.observe(s));
</script>
